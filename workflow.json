          "mappingMode": "defineBelow",
          "value": {
            "content_id": "={{ $json.content_id }}",
            "original_title": "={{ $json.title }}",
            "original_url": "={{ $json.url }}",
            "author": "={{ $json.author }}",
            "twitter_hook": "={{ $json.twitter_content?.hook ?? '' }}",
            "twitter_hashtags": "={{ JSON.stringify($json.twitter_content?.hashtags) }}",
            "linkedin_post": "={{ $json.linkedin_content?.post ?? '' }}",
            "email_subject": "={{ $json.email_content?.subject_line ?? '' }}",
            "instagram_caption": "={{ $json.instagram_content?.caption ?? '' }}",
            "status": "ready_to_schedule",
            "created_at": "={{ $json.created_at }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL"
        }
      }
