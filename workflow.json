                }
              ]
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "={{ ':label: Hashtags: ' + [...($json.twitter_content?.hashtags?.slice(0,3) ?? [])].join(' ') }}\nAll content saved and ready to schedule. Review before publishing!"
              }
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
